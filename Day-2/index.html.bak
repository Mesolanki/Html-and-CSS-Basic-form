<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Basic webpage design using Html & CSS</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>Website Name</h1>
        <p>Welcome to our platform</p>
    </header>

    <nav>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#about">About Us</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <main>
        <section>
            <h2>Main Menu Options</h2>
            <div class="menu-grid">
                <article>
                    <h3>Dashboard</h3>
                    <p>View your recent activity and statistics.</p>
                    <a href="/dashboard" class="btn">Go to Dashboard</a>
                </article>

                <article>
                    <h3>User Profile</h3>
                    <p>Manage your account settings and personal info.</p>
                    <a href="/profile" class="btn">Edit Profile</a>
                </article>

                <article>
                    <h3>Settings</h3>
                    <p>Adjust your preferences and notifications.</p>
                    <a href="/settings" class="btn">Open Settings</a>
                </article>
            </div>
        </section>

        <aside>
            <h4>Quick Links</h4>
            <ul>
                <li><a href="/help">Help Center</a></li>
                <li><a href="/faq">FAQs</a></li>
            </ul>
        </aside>
    </main>

    <footer>
        <p>&copy; 200 Company Name. All rights reserved.</p>
    </footer>

</body>
</html>
