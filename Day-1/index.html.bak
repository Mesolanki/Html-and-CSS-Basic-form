<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comprehensive Registration Form</title>
    <link rel="stylesheet" href="style.css" />
</head>
<body>

    <form action="#" method="post" enctype="multipart/form-data" class="form-container">
        <h2>Complete Registration Form</h2>

        <div class="form-group">
            <label for="username">Username</label>
            <input type="text" name="username" id="username" placeholder="Enter username" required />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" placeholder="Min 8 characters" />
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="hidden" name="email" id="email" value="xyz123@xyz.com" readonly />
        </div>

        <div class="form-group">
            <label>Gender</label>
            <div class="radio-group">
                <input type="radio" name="gender" id="male" value="male" />
                <label for="male">Male</label>
                <input type="radio" name="gender" id="female" value="female" />
                <label for="female">Female</label>
            </div>
        </div>

        <div class="form-group">
            <label>Interests</label>
            <input type="checkbox" id="coding" name="interest" value="coding">
            <label for="coding">Coding</label>
            <input type="checkbox" id="music" name="interest" value="music">
            <label for="music">Music</label>
        </div>

        <div class="form-group">
            <label for="dob">Date of Birth</label>
            <input type="date" name="dob" id="dob" />
        </div>

        <div class="form-group">
            <label for="appt-time">Preferred Contact Time (Time Input)</label>
            <input type="time" name="appt-time" id="appt-time" />
        </div>

        <div class="form-group">
            <label for="experience">Years of Experience (Number)</label>
            <input type="number" name="experience" id="experience" min="0" max="50" />
        </div>

        <div class="form-group">
            <label for="skill_level">Skill Level (Range: 0 to 100)</label>
            <input type="range" name="skill_level" id="skill_level" min="0" max="100" value="50" oninput="this.nextElementSibling.value = this.value">
            <output>50</output>
        </div>

        <div class="form-group">
            <label for="profile_pic">Profile Picture (Images only)</label>
            <input type="file" name="profile_pic" id="profile_pic" accept="image/*" />
        </div>

        <div class="form-group">
            <label for="resume">Upload Document (PDF/Docs)</label>
            <input type="file" name="resume" id="resume" accept=".pdf,.doc,.docx" />
        </div>

        <div class="form-group">
            <label for="website">Portfolio URL</label>
            <input type="url" name="website" id="website" placeholder="https://example.com" />
        </div>

        <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" name="phone" id="phone" placeholder="123-456-7890" />
        </div>

        <div class="form-group">
            <label for="color">Favorite Color</label>
            <input type="color" name="color" id="color" value="#4A90E2" />
        </div>

        <!-- BUTTONS -->
        <div class="button-group">
            <button type="submit" class="btn submit-btn">Submit Details</button>
            <button type="reset" class="btn reset-btn">Reset Form</button>
        </div>
    </form>

</body>
</html>